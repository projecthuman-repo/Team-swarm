# Copy to .env for host-run components (relay, agents, ingest).
# Containerized components get these from deploy/compose.yaml instead.

NATS_URL=nats://localhost:4222
DATABASE_URL=postgres://postgres:dev@localhost:5432/swarm
VALKEY_URL=valkey://localhost:6379

# OpenBao (Tier A dev server; Tier B uses the k8s injector instead)
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=dev-root

# Inference — Tier A: Ollama (baseline). Options:
#   35B on 24GB+:  AIDER_MODEL=ollama/maxwell1500/ornith-35b:Q4_K_M
#   vLLM upgrade (make vllm; >5 concurrent agents):
#     AIDER_MODEL=openai/Ornith-1.0-9B  OPENAI_API_BASE=http://localhost:8000/v1
#   Fallbacks (Apache-2.0): ollama/gpt-oss:20b, ollama/qwen2.5-coder:7b
OLLAMA_API_BASE=http://localhost:11434
AIDER_MODEL=ollama/maxwell1500/ornith-9b:Q4_K_M
AIDER_EDITOR_MODEL=ollama/maxwell1500/ornith-9b:Q4_K_M

# Execution engine: aider (baseline) | nano-claude-code, or a custom
# template via AGENT_ENGINE_CMD="mytool --prompt {message}"
AGENT_ENGINE=aider
#AGENT_ENGINE_CMD=

# Headroom token compression (v4.1 W1). Chain when fully enabled:
# aider -> headroom proxy -> LiteLLM -> {Ollama | vLLM | hosted API}.
# Baseline (direct Ollama) stays runnable — bypass per-role with
# HEADROOM_ENABLED=0, no redeploys. Assets: scripts/seed_headroom_assets.sh
HEADROOM_ENABLED=0
HEADROOM_URL=http://localhost:8787/v1
HEADROOM_STATS_URL=http://localhost:8787
HEADROOM_UPDATE_CHECK=off
HEADROOM_OUTPUT_SHAPER=0
HEADROOM_OUTPUT_HOLDOUT=0.1   # 10% unshaped control: savings MEASURED, not estimated
# `headroom` CLI for the morning learn loop: isolated uv tool env from
# `make tools` (default on PATH as ~/.local/bin/headroom). Never the agent env.
HEADROOM_BIN=headroom
HF_HUB_OFFLINE=1
ORT_STRATEGY=system
#ORT_LIB_LOCATION=deploy/headroom-assets/ort

# LiteLLM gateway + routing (v4.1 T4.3/T4.4). Local models are the
# structural primary; the hosted fallback is an explicit opt-in whose key
# is an OpenBao lease. Flag off => local failure fails closed to retry.
ROUTE_API_FALLBACK=0
#FALLBACK_API_BASE=
#FALLBACK_API_MODEL=
ROUTER_ENABLED=0              # RouteLLM proposal; adopt only on shadow-eval win

# Agent identity + limits
AGENT_ROLE=backend
DEFAULT_BUDGET_TOKENS=200000
TASK_TIMEOUT_S=1800
# Workspace policy (L1.6): task workdirs live under SANDBOX_WORKDIR (default:
# the system temp dir — /tmp, a size-capped tmpfs in the agent containers);
# on boot a worker removes task-* dirs untouched for TASK_TIMEOUT_S.
SANDBOX_WORKDIR=
SANDBOX_TMPFS_SIZE=4g         # compose /tmp tmpfs cap (k8s: emptyDir sizeLimit 4Gi)
WORKER_TIERS=default          # or auto (capacity probe) / "default,35b-q4"

# Independent verifier endpoint (L0.3). Unset = the Headroom proxy
# (HEADROOM_URL) when HEADROOM_ENABLED=1, else OPENAI_API_BASE / local Ollama.
#VERIFIER_API_BASE=http://localhost:11434/v1

# Green-build gate + grounded repair loop (v4.1 T2.1)
MAX_REPAIR_CYCLES=2
QUALITY_CHECKS=ruff check .;pytest -q
# Two-stage gate (L2.1): stage 1 lints only the changed .py files and returns
# at once when red; stage 2 = QUALITY_CHECKS + the task verify_cmd. Empty = off.
QUALITY_FAST_CHECK=ruff check --force-exclude
REPRO_TEST_POLICY=1

# Expensive-failure circuit breaker (v4.1 T5.3)
MAX_TASK_WALL_S=14400
MAX_TASK_ATTEMPTS=8

# Context management (v4.1 T6.4 / T2.4) — see conventions/context.md
CONTEXT_PACK=0
CONTEXT_PACK_TOKENS=2000
AIDER_MAP_TOKENS=1024

# Vector memory — backend: pgvector (baseline) | qdrant (make qdrant) |
# chroma (retained local-tier option). Embeddings (L2.3): EMBEDDING_BACKEND
# fastembed (default, no torch) | sentence-transformers (extra embeddings-torch;
# its default model is all-MiniLM-L6-v2). Models: BAAI/bge-small-en-v1.5 (384,
# default) or BAAI/bge-m3 (1024 — apply db/migrations/001 first). Any switch:
# run scripts/seed_knowledge.py --reembed.
VECTOR_BACKEND=pgvector
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
QDRANT_URL=http://localhost:6333
CHROMA_PATH=/tmp/chroma

# Observability sinks (all optional; unset = disabled).
#   Canonical (L3.2, make observability): OpenSearch logs · Jaeger traces ·
#   Prometheus metrics (/metrics, METRICS_REFRESH_S) · Perses dashboards ·
#   Langfuse LLM traces. In compose the agents default
#   OTEL_EXPORTER_OTLP_ENDPOINT to http://jaeger:4318; on the host use
#   http://localhost:4318. Swap: OpenObserve via OTLP — make openobserve
#METRICS_REFRESH_S=60
#RELAY_METRICS_PORT=9464
#LANGFUSE_HOST=http://localhost:3001
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#OPENSEARCH_URL=http://localhost:9200
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5080/api/default
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic ...

# Forgejo (the swarm's own git host — tokens live in OpenBao, NOT here)
FORGEJO_URL=http://localhost:3000
FORGEJO_OWNER=swarm
FORGEJO_REPO=sandbox-repo
FORGEJO_BOT_USER=swarm-bot

# Chat ingress: telegram (baseline) and/or slack,discord (Appendix B)
CHAT_SOURCES=telegram
TELEGRAM_ALLOWED_CHATS=
SLACK_CHANNEL_ID=
DISCORD_CHANNEL_ID=

# Apicurio (schema registry; ccompat endpoint for Confluent interop)
APICURIO_URL=http://localhost:8081

# Storage hygiene (L2.5, step 5 of `make morning`): published outbox rows
# older than this are deleted before VACUUM (ANALYZE); unpublished rows never.
OUTBOX_RETENTION_DAYS=7

# ---- Tunables with working defaults (L3.4: every variable the code reads) ----
# Worker loop
#LOG_LEVEL=INFO
#FETCH_TIMEOUT_S=30            # JetStream pull timeout per tier
#HEALTH_PORT=8080              # /healthz + /metrics
#QUALITY_CHECK_TIMEOUT_S=300   # per quality-gate command
#OPENBAO_INJECTED_DIR=/bao/secrets   # Tier B: files written by the OpenBao injector
# OpenAI-compatible endpoint for the planner and verifier (default: local Ollama)
#OPENAI_API_BASE=http://localhost:11434/v1
#PLANNER_MODEL=Ornith-1.0-9B
#PLANNER_DEFAULT_VERIFY=pytest -q
#VERIFIER_MODEL=Ornith-1.0-9B
#ROUTER_THRESHOLD=0.5          # RouteLLM strong-model threshold (ROUTER_ENABLED=1)
#SPECULATIVE_CANDIDATES=3      # make speculative: patch candidates per swarm-hard task
# LangGraph option (make graph)
#HIL=1                         # pause for human approval before work
#GRAPH_CHECKPOINT=postgres     # durable checkpoints (default: in-memory)
# Outbox relay (relay/relay.ts, relay/relay_cdc.ts)
#RELAY_POLL_MS=250
#RELAY_BATCH=100
#CDC_SLOT=outbox_slot
#CDC_PUBLICATION=outbox_pub
# Ingest
#CHAT_POLL_S=5
#COMPRESS_THRESHOLD_CHARS=8000 # compress chat/issue bodies above this size
#SEAWEED_FILER_URL=http://seaweedfs:8888
# Morning learn loop + CI gate
#SWARM_REPO=team-swarm         # the swarm's own repo for headroom-learn PRs
#HEADROOM_GATE_RATIO_FLOOR=0.25

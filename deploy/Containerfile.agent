# Agent worker image (Tier A and Tier B) — Lean & Precise L1.4.
# Runs with: read-only rootfs, cap-drop ALL, internal-only network,
# no .ssh, no host mounts (Hard Rules 1 & 6).
#
# Stage 1 resolves the locked `agent` and `gate` groups (base + aider-chat
# + the ruff/pytest the quality gate runs) into /opt/venv with uv; stage 2 is python:3.12-slim + git + that venv.

FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=0 \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --group agent --group gate \
 && find /opt/venv -depth -type d \( -name tests -o -name test \) -exec rm -rf {} + \
 && find /opt/venv -name '*.pyc' -delete

FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY agent/ agent/
COPY ingest/ ingest/
COPY scripts/ scripts/
COPY skills/ skills/
COPY conventions/ conventions/
COPY AGENTS.md identity.md user.md guardrails.md karpathy-guidelines.md .aider.conf.yml ./

RUN useradd --create-home --uid 10001 swarm
USER swarm

CMD ["python", "-m", "agent.agent_worker"]

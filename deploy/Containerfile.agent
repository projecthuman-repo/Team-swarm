# Agent worker image (Tier A and Tier B).
# Runs with: read-only rootfs, cap-drop ALL, internal-only network,
# no .ssh, no host mounts (Hard Rules 1 & 6).
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agent/ agent/
COPY ingest/ ingest/
COPY scripts/ scripts/
COPY skills/ skills/
COPY AGENTS.md identity.md user.md guardrails.md karpathy-guidelines.md .aider.conf.yml ./
COPY conventions/ conventions/

RUN useradd --create-home --uid 10001 swarm
USER swarm

ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "agent.agent_worker"]

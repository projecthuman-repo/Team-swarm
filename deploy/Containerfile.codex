# Codex engine lane image (v4.2 T7.3) — the agent worker with the Codex
# CLI installed, for when scripts/codex_egress_audit.sh shows Codex cannot
# run egress-free inside the sealed container. This lane has controlled
# egress (like the LiteLLM lane); it consumes the SAME JetStream subjects
# and pushes only to feature/* — the sealed container is never weakened.
#
# Lean toolchain (review R7): the Python closure comes from uv.lock, the
# same selection as the agent image (`agent` + `gate` groups), and the
# Codex CLI is pinned. @openai/codex is a Node launcher (bin/codex.js,
# `#!/usr/bin/env node`) around a per-platform binary, so the Node runtime
# stays in the image — the `node` binary is copied from the official node
# image instead of being installed with a remote script and purged again.

FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=0 \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --group agent --group gate \
 && find /opt/venv -depth -type d \( -name tests -o -name test \) -exec rm -rf {} + \
 && find /opt/venv -name '*.pyc' -delete

# Codex CLI — Apache-2.0, npm @openai/codex. The image's whole npm payload is
# deploy/codex/package-lock.json: the launcher and the platform package that
# carries the native binary, with integrity hashes. The license gate scans
# that lock (Zone C). To raise the version: edit deploy/codex/package.json
# and CODEX_VERSION, then `npm install --package-lock-only --ignore-scripts`
# in deploy/codex. The build fails when the two disagree.
FROM node:22-slim AS codex
ARG CODEX_VERSION=0.167.0
WORKDIR /opt/codex
COPY deploy/codex/package.json deploy/codex/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
 && test -f node_modules/@openai/codex/bin/codex.js \
 && test "$(node -p "require('./node_modules/@openai/codex/package.json').version")" = "${CODEX_VERSION}" \
 && rm -rf node_modules/@openai/codex-linux-*/vendor/*/codex-resources/voice \
           node_modules/@openai/codex-linux-*/vendor/*/codex-resources/bwrap
# ^ Two things the platform package carries beside the Apache-2.0 CLI, per
# upstream's packaging at this tag, that a permissive-only image must not
# ship and that this lane does not use: a GStreamer/GLib runtime for voice
# input (LGPL-2.1) and a bundled bubblewrap (LGPL-2.0-or-later) — Codex's own
# sandbox, which is off here (`--sandbox danger-full-access`; the hardened
# container cannot create the user namespaces it needs anyway). The runtime
# stage asserts that neither is left, wherever the package put them.

FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
# Node itself and the Codex packages — nothing else of the node image. Its
# global node_modules (npm, Artistic-2.0; corepack) stay behind: nothing at
# run time needs them, and no gate would judge them.
COPY --from=codex /usr/local/bin/node /usr/local/bin/node
COPY --from=codex /opt/codex/node_modules /opt/codex/node_modules
RUN ln -s /opt/codex/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
 && codex --version \
 && test -z "$(find /opt/codex/node_modules \( -name bwrap -o -name 'libgst*' -o -name 'libglib*' -o -name voice \) -print -quit)"
# The offline profile, as Codex's system config layer: read from the
# read-only root whatever CODEX_HOME holds (deploy/codex/config.toml).
COPY deploy/codex/config.toml /etc/codex/config.toml
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    AGENT_ENGINE=codex

WORKDIR /app
COPY agent/ agent/
COPY ingest/ ingest/
COPY scripts/ scripts/
COPY skills/ skills/
COPY AGENTS.md identity.md user.md guardrails.md karpathy-guidelines.md .aider.conf.yml ./
COPY conventions/ conventions/

RUN useradd --create-home --uid 10001 swarm
USER swarm

CMD ["python", "-m", "agent.agent_worker"]

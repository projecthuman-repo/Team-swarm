# Headroom token-compression proxy (v4.1 T1.2) — chopratejas/headroom,
# PyPI headroom-ai, Apache-2.0. Runs on swarm-internal with NO egress:
# runtime assets (ONNX runtime, Kompress model) are pre-provisioned into
# the read-only /assets volume by scripts/seed_headroom_assets.sh (T1.4).
#
# Built from uv.lock (review R1): the `headroom-proxy` group pins
# headroom-ai[proxy]==0.31.0. `headroom proxy` needs the `proxy` extra
# (fastapi, uvicorn, …); the unpinned install this file used before left it
# out, so the container exited at start-up.

FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=0 \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /src
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --only-group headroom-proxy \
 && find /opt/venv -depth -type d \( -name tests -o -name test \) -exec rm -rf {} + \
 && find /opt/venv -name '*.pyc' -delete

FROM python:3.12-slim
COPY --from=builder /opt/venv /opt/venv

RUN useradd --create-home --uid 10001 headroom
USER headroom

# No-egress posture (DR-3): never phone PyPI/HF/CDN at runtime.
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HEADROOM_UPDATE_CHECK=off \
    HF_HUB_OFFLINE=1 \
    ORT_STRATEGY=system \
    ORT_LIB_LOCATION=/assets/ort \
    HF_HOME=/assets/hf \
    HEADROOM_HOST=0.0.0.0 \
    HEADROOM_PORT=8787

CMD ["headroom", "proxy"]

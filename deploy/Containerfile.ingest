# Ingest image (Lean & Precise L0.2 / L1.4): chat ingress + Forgejo issue
# sync, with headroom-ai for compress()/SmartCrusher (T1.8).
#
# Separate from the agent image because headroom-ai==0.31.0 and aider-chat
# cannot co-resolve (litellm >=1.86.2 vs ==1.81.10 — the declared uv
# conflict). No git, no aider. ingest/ imports only agent.openbao and
# agent.router (both lazily) plus the generated protobuf code — agent.lessons
# is NOT imported, so it is not copied. The `ingest` group carries every
# library ingest imports (DECISIONS D-010), so --only-group is complete.

FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=0 \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /src
COPY pyproject.toml uv.lock ./
# headroom-ai pulls boto3/botocore/s3transfer and the 51 MB ast-grep binary,
# none of which compress() touches: four probes (JSON tool output, small and
# 127 KB code bodies, a 4,000-line log) give byte-identical output without
# them (DECISIONS D-017). Skipped declaratively; uv.lock is unchanged.
RUN uv sync --frozen --no-install-project --only-group ingest \
      --no-install-package boto3 --no-install-package botocore \
      --no-install-package s3transfer --no-install-package ast-grep-cli \
 && find /opt/venv -depth -type d \( -name tests -o -name test \) -exec rm -rf {} + \
 && find /opt/venv -name '*.pyc' -delete

FROM python:3.12-slim
COPY --from=builder /opt/venv /opt/venv
# No-egress posture for the library path too (DR-3): never phone PyPI.
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HEADROOM_UPDATE_CHECK=off

WORKDIR /app
COPY ingest/ ingest/
COPY agent/__init__.py agent/openbao.py agent/router.py agent/
COPY agent/gen/ agent/gen/

RUN useradd --create-home --uid 10001 swarm
USER swarm

CMD ["python", "-m", "ingest.chat_ingress"]

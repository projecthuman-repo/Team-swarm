# Outbox relay image — the only publisher into JetStream (Hard Rule 2).
# Locked install (L0.4): package-lock.json is copied and `npm ci` installs
# exactly what it pins. Both entrypoints ship: relay.ts (poll, default) and
# relay_cdc.ts (logical-replication CDC; compose `command` switches to it).
FROM node:22-alpine

WORKDIR /app
COPY relay/package.json relay/package-lock.json relay/tsconfig.json ./
# Plain `npm ci`: --omit=optional would drop esbuild's lockfile-pinned
# platform binary (tsx -> esbuild) and make it fetch one outside the lock.
RUN npm ci && npm cache clean --force
COPY relay/relay.ts relay/relay_cdc.ts ./

RUN adduser -D -u 10001 swarm
USER swarm

CMD ["npx", "tsx", "relay.ts"]

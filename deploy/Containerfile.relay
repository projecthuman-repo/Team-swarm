# Outbox relay image — the only publisher into JetStream (Hard Rule 2).
FROM node:22-alpine

WORKDIR /app
COPY relay/package.json relay/tsconfig.json ./
RUN npm install --omit=optional && npm cache clean --force
COPY relay/relay.ts ./

RUN adduser -D -u 10001 swarm
USER swarm

CMD ["npx", "tsx", "relay.ts"]

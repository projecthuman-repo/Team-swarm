[
  {
    "kind": "Project",
    "metadata": { "name": "swarm" },
    "spec": { "display": { "name": "Overnight Agent Swarm" } }
  },
  {
    "kind": "GlobalDatasource",
    "metadata": { "name": "prometheus" },
    "spec": {
      "default": true,
      "plugin": {
        "kind": "PrometheusDatasource",
        "spec": {
          "proxy": { "kind": "HTTPProxy", "spec": { "url": "http://prometheus:9090" } }
        }
      }
    }
  }
]

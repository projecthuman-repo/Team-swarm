#!/usr/bin/env python3
"""Sample skill: proves the sandbox works. Reads stdin, writes stdout.

A skill is any executable named `run` in skills/<name>/. It gets:
  - no network (socket() fails)
  - read-only rootfs except a 64MB tmpfs at /work
  - no capabilities, seccomp-filtered syscalls

Try it:   echo world | skills/run_skill.sh hello
Verify isolation:  skills/run_skill.sh hello --prove-isolation
"""
import socket
import sys

if "--prove-isolation" in sys.argv:
    try:
        socket.create_connection(("1.1.1.1", 443), timeout=3)
        print("FAIL: sandbox let a socket out", file=sys.stderr)
        sys.exit(1)
    except OSError:
        print("ok: network unreachable from sandbox")
    try:
        open("/etc/hostname-test", "w")
        print("FAIL: rootfs is writable", file=sys.stderr)
        sys.exit(1)
    except OSError:
        print("ok: rootfs is read-only")
    sys.exit(0)

name = sys.stdin.read().strip() or "swarm"
print(f"hello, {name}")
